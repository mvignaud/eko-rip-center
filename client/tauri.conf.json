{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "E-KO RIP Center",
  "identifier": "fr.e-ko.rip-center",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "E-KO RIP Center",
        "width": 1200,
        "height": 850,
        "minWidth": 400,
        "minHeight": 400,
        "userAgent": "Mozilla/5.0 (E-KO RIP Center) EKO-RIP-Client/1",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --lang=fr"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Graphics and Design",
    "shortDescription": "Client du RIP E-KO RIP Center",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
