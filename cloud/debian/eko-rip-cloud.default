# Réglages de la plate-forme E-KO RIP Cloud. Redémarrer après modification :
#   systemctl restart eko-rip-cloud
# Écoute locale : Caddy (HTTPS) fait suivre platform.e-ko.rip vers cette adresse.
#EKO_CLOUD_ADDR=127.0.0.1:8650
# Adresse publique (liens d'appairage, adresses des sites).
#EKO_CLOUD_URL=https://platform.e-ko.rip
# Taille maximale d'une requête vers un site (Mo).
#EKO_CLOUD_MAX_MO=2048
# Jeton des statistiques anonymes d'installations (GET /api/installations, en Bearer) ;
# vide : route fermée. `eko-rip-cloud installations` les donne aussi sur le VPS.
#EKO_CLOUD_JETON_STATS=
# E-mails (mot de passe oublié, alertes, résumé) : serveur SMTP, expéditeur no-reply@e-ko.fr.
# Ils se saisissent aussi dans Administration › E-mails ; ces variables priment si présentes.
#EKO_CLOUD_SMTP_HOTE=
#EKO_CLOUD_SMTP_PORT=587
# starttls (587) ou tls (465)
#EKO_CLOUD_SMTP_SECURITE=starttls
#EKO_CLOUD_SMTP_IDENTIFIANT=
#EKO_CLOUD_SMTP_MOT_DE_PASSE=
#EKO_CLOUD_SMTP_EXPEDITEUR=no-reply@e-ko.fr
# Push mobile (Expo) : jeton d'accès Expo, facultatif (envoyé en Authorization: Bearer).
#EKO_CLOUD_EXPO_TOKEN=
# Support en direct (bulle des pages connectées) : jeton public de la boîte et clé de
# vérification d'identité (HMAC). Si l'une manque, pas de bulle.
#CHATWOOT_WEBSITE_TOKEN=
#CHATWOOT_HMAC_TOKEN=
