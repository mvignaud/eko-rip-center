#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    if ! getent passwd eko-rip >/dev/null; then
        adduser --system --group --home /var/lib/eko-rip --no-create-home eko-rip
    fi
    install -d -o eko-rip -g eko-rip -m 0750 /var/lib/eko-rip
    echo "E-KO RIP : accès à distance par le Cloud E-KO RIP (https://platform.e-ko.rip) :"
    echo "  Système › Cloud E-KO RIP › Connecter à la plate-forme, puis saisir le code sur la plate-forme."
fi
#DEBHELPER#
