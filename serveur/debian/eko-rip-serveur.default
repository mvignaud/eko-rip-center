# Réglages du serveur E-KO RIP Center. Redémarrer après modification :
#   systemctl restart eko-rip-serveur
#EKO_RIP_ADDR=0.0.0.0:8640
#EKO_RIP_MAX_MO=8192
#EKO_RIP_DELAI_S=1800
# Travaux effacés après ce nombre de jours (0 : jamais).
#EKO_RIP_CONSERVATION_JOURS=30
#EKO_RIP_SEUIL_LIBRE_MO=5120
# Seuil bas (Mo) : en dessous, chaque nouveau travail porte une alerte « disque presque plein ».
#EKO_RIP_SEUIL_ALERTE_MO=20480
# 1 : travaux venus de l'ERP effacés dès qu'ils sont imprimés (et découpés).
#EKO_RIP_PURGER_ERP_FAITS=0
# Plotter de découpe (le Mutoh Kona apparaît en /dev/kona) et réglages du port :
#EKO_RIP_PLOTTER=/dev/kona
#EKO_RIP_PLOTTER_STTY=9600 cs8 -cstopb -parenb crtscts raw -echo
# Adresse IP de l'Epson (SNMP) : largeur du média chargé, reprise comme laize.
#EKO_RIP_EPSON_SNMP=192.168.1.50
#EKO_RIP_EPSON_COMMUNAUTE=public
# 1 : interface complète aussi dans un navigateur (développement seulement).
#EKO_RIP_ACCES_NAVIGATEUR=0
# Cloud E-KO RIP : plate-forme d'accès à distance (sans VPN ni port ouvert). Le serveur s'y
# rattache depuis Système › Cloud E-KO RIP › Connecter à la plate-forme (code à saisir sur
# https://platform.e-ko.rip). Les statistiques anonymes et les rapports de bug y partent aussi.
EKO_RIP_CLOUD_URL=https://platform.e-ko.rip
# 0 : aucun ping anonyme d'installation vers la plate-forme E-KO RIP (sinon : à l'installation,
# à chaque mise à jour puis chaque semaine ; identifiant aléatoire, OS, version, nombre de
# machines et de réglages). Aussi réglable dans Système.
#EKO_TELEMETRIE=1
# Rendu plus long que ce nombre de minutes : rapport de bug automatique « lenteur » (seulement si
# les rapports automatiques ont été acceptés dans Système › Rapports de bug).
#EKO_RIP_LENTEUR_MIN=30
