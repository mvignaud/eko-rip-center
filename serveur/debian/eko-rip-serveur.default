# Réglages du serveur E-KO RIP Center. Redémarrer après modification :
#   systemctl restart eko-rip-serveur
#EKO_RIP_ADDR=0.0.0.0:8640
#EKO_RIP_MAX_MO=8192
#EKO_RIP_DELAI_S=1800
# Travaux effacés après ce nombre de jours (0 : jamais).
#EKO_RIP_CONSERVATION_JOURS=30
#EKO_RIP_SEUIL_LIBRE_MO=5120
# Plotter de découpe (le Mutoh Kona apparaît en /dev/kona) et réglages du port :
#EKO_RIP_PLOTTER=/dev/kona
#EKO_RIP_PLOTTER_STTY=9600 cs8 -cstopb -parenb crtscts raw -echo
# Adresse IP de l'Epson (SNMP) : largeur du média chargé, reprise comme laize.
#EKO_RIP_EPSON_SNMP=192.168.1.50
#EKO_RIP_EPSON_COMMUNAUTE=public
# 1 : interface complète aussi dans un navigateur (développement seulement).
#EKO_RIP_ACCES_NAVIGATEUR=0
