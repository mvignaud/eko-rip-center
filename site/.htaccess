# E-KO RIP Center — site e-ko.rip (Apache, hébergement o2switch).

Options -Indexes
DirectoryIndex index.html

RewriteEngine On
# HTTPS partout, et une seule adresse : e-ko.rip (www renvoie dessus).
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://e-ko.rip%{REQUEST_URI} [R=301,L]

# Téléchargement direct du client, toujours sur la dernière version publiée sur GitHub.
RewriteRule ^telecharger/(mac|windows)/?$ /telecharger/telecharger.php?os=$1 [L,QSA]

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  # Seules ressources externes : le journal et l'abonnement, servis par l'ERP.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https://app.e-ko.fr; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://app.e-ko.fr"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 5 minutes"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType text/javascript "access plus 1 hour"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>
